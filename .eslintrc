{
  "root": true,
  "env": {"browser": true, "es2022": true},
  "extends": [
    "prettier",
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "ignorePatterns": ["dist", ".eslintrc.cjs"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["prettier"],
  "rules": {
    "no-undef": "error",
    "no-console": "warn",
    "no-duplicate-imports": "error",
    "no-unused-vars": "warn",
    "prettier/prettier": [
      "warn",
      {
        "bracketSpacing": true,
        "printWidth": 120,
        "singleQuote": true,
        "trailingComma": "none",
        "tabWidth": 3,
        "useTabs": false
      }
    ]
  }
}